table 'FLYER DATA'
	lineageTag: 61237738-9558-4a3c-8158-04273902ad97

	measure 'Flyer P Price Custom' = AVERAGE ( 'FLYER DATA'[Priceperkg_ltr_Calculated] )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: 99c7caef-44a7-42c8-91be-5b27a8b3de5b

	measure 'Flyer P Price YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'FLYER DATA'[Priceperkg_ltr_Calculated] ),
			        FILTER (
			            ALL ( 'FLYER DATA'[offerstartdate] ),
			            'FLYER DATA'[offerstartdate] <= LastDataDate
			                && YEAR ( 'FLYER DATA'[offerstartdate] ) = YEAR ( LastDataDate )
			        )
			    )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: 73d17260-796c-4f96-8de7-21eee8fa2178

	measure 'Flyer P Price MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'FLYER DATA'[Priceperkg_ltr_Calculated] ),
			        KEEPFILTERS ( 'FLYER DATA'[offerstartdate] > CutoffDate ),
			        KEEPFILTERS ( 'FLYER DATA'[offerstartdate] <= GlobalMaxDate )
			    )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: 795577b5-a493-452b-9f7a-67beb19388ee

	measure 'Flyer P Price LY Custom' = CALCULATE ( [Flyer P Price Custom], DATEADD ( 'dates'[monthdate], -1, YEAR ) )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: 906906da-3614-4744-b082-b55405096e0c

	measure 'Flyer P Price LY YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'FLYER DATA'[Priceperkg_ltr_Calculated] ),
			        FILTER (
			            ALL ( 'FLYER DATA'[offerstartdate] ),
			            'FLYER DATA'[offerstartdate] <= EDATE ( LastDataDate, -12 )
			                && YEAR ( 'FLYER DATA'[offerstartdate] ) = YEAR ( LastDataDate ) - 1
			        )
			    )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: 97a37d38-a3aa-4300-9225-1c70c0e90387

	measure 'Flyer P Price LY MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR AnchorLY = EDATE ( GlobalMaxDate, -12 )
			VAR CutoffLY = EDATE ( AnchorLY, -12 )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'FLYER DATA'[Priceperkg_ltr_Calculated] ),
			        KEEPFILTERS ( 'FLYER DATA'[offerstartdate] > CutoffLY ),
			        KEEPFILTERS ( 'FLYER DATA'[offerstartdate] <= AnchorLY )
			    )
		formatString: 0.00
		displayFolder: Flyer P Price
		lineageTag: c2619414-3b79-48da-8b91-9df74af0a9c2

	measure 'Flyer P Price Share Custom' = DIVIDE ( [Flyer P Price Custom], CALCULATE ( [Flyer P Price Custom], ALL ( 'FLYER DATA' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Flyer P Price
		lineageTag: 6d23d2d1-d2f2-437e-8b2d-3c48008778a4

