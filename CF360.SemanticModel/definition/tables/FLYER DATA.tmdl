	partition 'FLYER DATA' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database(){[Name="henkel-clicflyer"]}[Data], "SELECT DISTINCT#(lf)    Year,#(lf)    type AS `PROMO TYPE`,#(lf)    Offerid,#(lf)    offerstartdate,#(lf)    offerenddate,#(lf)    promoprice,#(lf)    regularprice,#(lf)    promoquantity,#(lf)    Offerpriceperpacksize,#(lf)    retailerid,#(lf)    retailername AS `CUSTOMER GROUP`,#(lf)    brandid,#(lf)    brandname AS `BRAND`,#(lf)    '' AS `BRAND STRATEGY`,#(lf)    productid,#(lf)    productname,#(lf)    packsizeid,#(lf)    packsize AS `SIZE`,#(lf)    bu AS `BU`,#(lf)    category_SBU AS `SUB CATEGORY`,#(lf)    Sub_Category AS `FORMAT`,#(lf) #(lf)    CASE#(lf)        WHEN AnalyticsIsParent = TRUE THEN 1#(lf)        ELSE 0#(lf)    END AS parent,#(lf) #(lf)    discount,#(lf)    Discount_percent,#(lf) #(lf)    CASE#(lf)        WHEN countryid = 1 THEN 'Saudi Arabia'#(lf)        WHEN countryid = 2 THEN 'Kuwait'#(lf)        WHEN countryid = 3 THEN 'UAE'#(lf)        WHEN countryid = 4 THEN 'Bahrain'#(lf)        WHEN countryid = 5 THEN 'Qatar'#(lf)        WHEN countryid = 6 THEN 'Oman'#(lf)    END AS `COUNTRY`,#(lf) #(lf)    CASE#(lf)        WHEN brandname IN (""Loreal Paris"", ""Loreal Elvive"") THEN ""Competitor""#(lf)        ELSE BrandFlag#(lf)    END AS Flag,#(lf) #(lf)    year_month AS Yearmonth,#(lf) #(lf)    CONCAT(#(lf)        FORMAT_DATE('%b', offerstartdate),#(lf)        "" "",#(lf)        EXTRACT(YEAR FROM offerstartdate)#(lf)    ) AS MonthYear,#(lf) #(lf)    CONCAT(#(lf)        ""Q"",#(lf)        EXTRACT(QUARTER FROM offerstartdate),#(lf)        "" "",#(lf)        EXTRACT(YEAR FROM offerstartdate)#(lf)    ) AS QuarterYear,#(lf) #(lf)    CASE#(lf)        WHEN channel = """" THEN ""Others""#(lf)        ELSE channel#(lf)    END AS `CHANNEL`,#(lf) #(lf)    '' AS `SUB-CHANNEL`,#(lf)    '' AS `DISTRIBUTOR`,#(lf) #(lf)    CASE#(lf)        WHEN Sub_Category LIKE 'Hair Dye' THEN Offerpriceperpacksize#(lf)        WHEN Sub_Category LIKE 'RimBlocks' THEN Offerpriceperpacksize#(lf)        ELSE OfferPriceperKgL#(lf)    END AS Priceperkg_ltr_Calculated,#(lf) #(lf)    'OFFLINE' AS `SALES TYPE`,#(lf)    '' AS `PRICE BRAND`,#(lf)    '' AS `PRODUCT TYPE`,#(lf)    '' AS `PRICE TIER`#(lf) #(lf)FROM `henkel-clicflyer.henkel_raw_data.Flyer_PromoAnalysis_tbl_Henkel`#(lf)WHERE region = 'All' and year_month >= 202501", null, [EnableFolding=true]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"BU", "SUB CATEGORY", "FORMAT"}, #"Hierarchy Index", {"BU", "SubCategory", "Format"}, "Hierarchy Index", JoinKind.LeftOuter),
				    #"Expanded Hierarchy Index" = Table.ExpandTableColumn(#"Merged Queries", "Hierarchy Index", {"RNN"}, {"Hierarchy Index.RNN"})
				in
				    #"Expanded Hierarchy Index"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

