	partition 'IMS Processed' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database(){[Name="henkel-clicflyer"]}[Data], "SELECT distinct * FROM `henkel-clicflyer.AnalyticsSolution.ims_processed_data_henkel`#(lf)WHERE BU IS NOT NULL AND SubCategory IS NOT NULL and format is not null", null, [EnableFolding=true]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"BU", "SubCategory", "Format"}, #"Hierarchy Index", {"BU", "SubCategory", "Format"}, "Hierarchy Index", JoinKind.LeftOuter),
				    #"Expanded Hierarchy Index" = Table.ExpandTableColumn(#"Merged Queries", "Hierarchy Index", {"RNN"}, {"Hierarchy Index.RNN"})
				in
				    #"Expanded Hierarchy Index"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

