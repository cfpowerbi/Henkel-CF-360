	measure 'Gross IMS P Dynamic in M' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			VAR RESULT =
			    SWITCH (
			        SelectedMode,
			        "YTD", [Gross IMS P YTD],
			        "MAT", [Gross IMS P MAT],
			        [Gross IMS P Custom]
			    )
			RETURN
			    DIVIDE ( RESULT, 1000000 )
		formatString: #,##0.00"M"
		displayFolder: Gross IMS P
		lineageTag: c23aa7f4-cfc3-49a1-a3c4-4a091c534781

