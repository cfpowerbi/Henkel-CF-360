table 'IMS Processed'
	lineageTag: 39a5ca05-5400-4f89-a59e-3d021613a5a7

	measure Grossmsly1 =
			
			DIVIDE(
			    SUM('IMS Processed'[grossims]),
			    CALCULATE(SUM('IMS Processed'[grossims]), ALL('IMS Processed')),
			    0
			)
		lineageTag: 9231c2e8-d60c-427f-80bc-47c855432e54

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross IMS P Custom' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CustomSum = SUM ( 'IMS Processed'[grossims] )
			VAR YTDSum = CALCULATE (
			    SUM ( 'IMS Processed'[grossims] ),
			    FILTER (
			        ALL ( 'IMS Processed'[Date] ),
			        'IMS Processed'[Date] <= LastDataDate
			            && YEAR ( 'IMS Processed'[Date] ) = YEAR ( LastDataDate )
			    )
			)
			RETURN
			    IF ( SelectedMode = "YTD", YTDSum, CustomSum )
		formatString: 0.00
		displayFolder: Gross IMS P
		lineageTag: 596a986a-5012-42ed-b8ed-425f51378bbd

