	/// P&L-IMS display wrapper: same value as [Investment P Growth Dynamic] with the
	/// HTML's arrow baked into the format string. Base measure untouched.
	measure 'IMS PnL L6 Growth Arrow' = [Investment P Growth Dynamic]
		formatString: "▲ +"0.0%;"▼ -"0.0%;0.0%
