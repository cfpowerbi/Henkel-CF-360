	measure 'Gross IMS P MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'IMS Processed'[grossims] ),
			        KEEPFILTERS ( 'IMS Processed'[Date] > CutoffDate ),
			        KEEPFILTERS ( 'IMS Processed'[Date] <= GlobalMaxDate )
			    )
		formatString: 0.00
		displayFolder: Gross IMS P
		lineageTag: 46d03c32-0837-4abd-b318-03b113ab25ce

