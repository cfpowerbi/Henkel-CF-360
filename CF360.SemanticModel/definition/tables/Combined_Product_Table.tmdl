	partition Combined_Product_Table = calculated
		mode: import
		source = ```
				
				UNION (
				    SELECTCOLUMNS (
				        'EPOS Processed data',
				        "Source", "EPOS",
				        "Brand", [Brand],
				        "Manufacturer", [Manufacturer],
				        "Size", [Size],
				        "Sales_Type", [Sales_Type],
				        "PromoType", [PromoType],
				        "Product Type", [Product Type]
				    ),
				    
				    SELECTCOLUMNS (
				        'Nielsen Processed',
				        "Source", "Nielsen",
				        "Brand", [Brand],
				        "Manufacturer", [Manufacturer],
				        "Size", [Size],
				        "Sales_Type", [Sales_Type],
				        "PromoType", [PromoType],
				        "Product Type", [Product Type]
				    ),
				    
				    SELECTCOLUMNS (
				        'IMS Processed',
				        "Source", "IMS",
				        "Brand", [Brand],
				        "Manufacturer", "Not Defined",
				        "Size", [Size],
				        "Sales_Type", [Sales_Type],
				        "PromoType", [PromoType],
				        "Product Type", "Not Defined"
				    )
				)
				
				```

	annotation PBI_Id = 71fa6ae32819463581d5b42eddaae302

