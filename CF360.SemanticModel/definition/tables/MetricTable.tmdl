	/// Unified: returns Value or Volume based on Metric Slicer + Source
	measure 'Channel Metric' = ```
			VAR _metric = SELECTEDVALUE('Metric Slicer'[MetricOrder], 0)
			RETURN
			    SWITCH(
			        _metric,
			        0, [Channel Value],
			        1, [Channel Volume],
			        2, [Channel Price]
			 
			    )
			```
		displayFolder: Channel Analysis
		lineageTag: 0520ce77-bfcb-400e-becd-86dc425c8cce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Unified Share: returns Value Share or Volume Share
	measure 'Channel Metric Share' =
			VAR _metric = SELECTEDVALUE('Metric Slicer'[MetricOrder], 0)
			RETURN
			    SWITCH(
			        _metric,
			        0, [Channel Value Share],
			        1, [Channel Volume Share],
			        2,BLANK()
			    )
		formatString: 0.0%
		displayFolder: Channel Analysis
		lineageTag: d729164a-8ca1-4908-bd6c-bc2981a91bae

	/// Unified Growth: returns Value Growth or Volume Growth
	measure 'Channel Metric Growth' =
			VAR _metric = SELECTEDVALUE('Metric Slicer'[MetricOrder], 0)
			RETURN
			    SWITCH(
			        _metric,
			        0, [Channel Value Growth],
			        1, [Channel Volume Growth],
			        2,[Channel Price Growth]
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Channel Analysis
		lineageTag: 5e512a2c-7118-4a75-a795-01d90ddf4a2f

