	partition MetricTable = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Source", STRING,
				    "Metric", STRING,
				    "SortOrder", INTEGER,
				    {
				        {"IMS", "Value",       1},
				        {"IMS", "Val Chg%",    2},
				        {"IMS", "Vol Shr",     3},
				        {"IMS", "Investment",  4},
				        {"IMS", "NES",         5},
				        {"IMS", "GP1",         6},
				        {"IMS", "GP1%",       7},
				        {"IMS", "L6%",        8},
				        {"NIELSEN", "Value",  9},
				        {"NIELSEN", "Val Chg%",10},
				        {"NIELSEN", "Val Shr", 11},
				        {"NIELSEN", "Volume",  13},
				        {"NIELSEN", "Vol Chg%",14},
				        {"NIELSEN", "Vol Shr", 15},
				        {"EPOS", "Value",  16},
				        {"EPOS", "Val Chg%",17},
				        {"EPOS", "Val Shr", 18},
				        {"EPOS", "Volume",  19},
				        {"EPOS", "Vol Chg%",20},
				        {"EPOS", "Vol Shr", 21}
				    }
				)

