table MetricTable
	lineageTag: da24932d-38fb-4d9d-a8af-9abbe629e8c2

	measure DisplayValueNEW =
			
			VAR _source = SELECTEDVALUE(MetricTable[Source])
			VAR _metric = SELECTEDVALUE(MetricTable[Metric])
			RETURN
			SWITCH(TRUE(),
			    -- IMS metrics
			    _source = "IMS" && _metric = "Value",       'IMS Processed'[Gross IMS P Dynamic],
			    _source = "IMS" && _metric = "Val Chg%",    'IMS Processed'[Gross IMS P Change dynamic],
			    _source = "IMS" && _metric = "Vol Shr",     'IMS Processed'[Gross IMS P Share Dynamic],
			    _source = "IMS" && _metric = "Investment",  'IMS Processed'[Investment P Dynamic],
			    _source = "IMS" && _metric = "NES",         'IMS Processed'[ΔNES P dynamic],
			    _source = "IMS" && _metric = "GP1",         'IMS Processed'[GP1 P Dynamic],
			    _source = "IMS" && _metric = "GP1%",        'IMS Processed'[GP1% P Dynamic],
			    _source = "IMS" && _metric = "L6%",         'IMS Processed'[L6% P Dynamic],
			
			    -- Nielsen metrics
			    _source = "Nielsen" && _metric = "Value",      'Nielsen Processed'[Nielsen P Value Dynamic],
			    _source = "Nielsen" && _metric = "Val Chg%",   'Nielsen Processed'[Nielsen P Value Change dynamic],
			    _source = "Nielsen" && _metric = "Vol Shr",    'Nielsen Processed'[Nielsen P Value Share Dynamic],
			    _source = "Nielsen" && _metric = "Vol",  'Nielsen Processed'[Nielsen P Vol Dynamic],
			    _source = "Nielsen" && _metric = "Vol Chg%",     'Nielsen Processed'[Nielsen P Vol Change dynamic],
			    _source = "Nielsen" && _metric = "Vol Shr",      'Nielsen Processed'[Nielsen P Vol Share Dynamic],
			
			    -- EPOS metrics
			    _source = "EPOS" && _metric = "Value",        'EPOS Processed data'[EPOS P Value Dynamic],
			    _source = "EPOS" && _metric = "Val Chg%",       'EPOS Processed data'[EPOS P Value Change dynamic],
			    _source = "EPOS" && _metric = "Val Shr",                   'EPOS Processed data'[EPOS P Value Share Dynamic],
			    _source = "EPOS" && _metric = "Vol",                     'EPOS Processed data'[EPOS P Volume Dynamic],
			    _source = "EPOS" && _metric = "Vol Chg%",                   'EPOS Processed data'[EPOS P Volume Change dynamic],
			
			    BLANK()
			)
		lineageTag: 2f32f495-7fcd-48e2-9e67-9db750d39191

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Bridge measure: returns Value dynamic for selected Source
	measure 'Channel Value' =
			VAR _src = SELECTEDVALUE('Source'[Source])
			RETURN
			    SWITCH(
			        TRUE(),
			        _src = "EPOS",    [EPOS P Henkel Value Dynamic],
			        _src = "NIELSEN", [Nielsen P Henkel Value Dynamic],
			        _src = "IMS",     [Gross IMS P Dynamic],
			        BLANK()
			    )
		formatString: #,0.0
		displayFolder: Channel Analysis
		lineageTag: b2eb28a6-755d-4027-a64d-8362833bc469

