table 'Hierarchy Index'
	lineageTag: f27288ba-fdfa-4b2c-96b1-1d3526950b4a

	/// Dynamic BU label for the Country Level Analysis header, mirroring the HTML's
	/// bunav_pbc7_label. Follows the same shape as 'All channel'[Selected Country Heading].
	measure 'Selected BU Heading' =
			VAR _sel = VALUES ( 'Hierarchy Index'[BU] )
			VAR _n = COUNTROWS ( _sel )
			VAR _tot = COUNTROWS ( ALL ( 'Hierarchy Index'[BU] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        _n = 1, CONCATENATEX ( _sel, 'Hierarchy Index'[BU] ),
			        _n = _tot, "All BUs",
			        CONCATENATEX ( _sel, 'Hierarchy Index'[BU], ", " )
			    )
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910001

	column BU
		dataType: string
		lineageTag: 07383f97-f7b7-4899-a28e-cafd99847e51
		summarizeBy: none
		sourceColumn: BU
		sortByColumn: rank

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column SubCategory
		dataType: string
		lineageTag: f6dda28b-3983-4aff-9a81-38a627e92f06
		summarizeBy: none
