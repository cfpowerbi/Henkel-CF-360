	column rank
		dataType: int64
		formatString: 0
		lineageTag: 91e0f22f-3ffe-4de5-9ecc-e6ede68c12a0
		summarizeBy: sum
		sourceColumn: rank

		annotation SummarizationSetBy = Automatic

	partition 'Hierarchy Index' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database(){[Name="henkel-clicflyer"]}[Data], "SELECT #(lf) BU,SubCategory,Format,RNN,IF(bu = ""Laundry Care"", 1, IF(bu = ""Home Care"", 2, IF(bu = ""Beauty Care"", 3, 0))) AS rank#(lf)#(lf)FROM `henkel-clicflyer.AnalyticsSolution.processed_data_henkel_heirarchy`", null, [EnableFolding=true])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

