table 'Ecom Data'
	lineageTag: 3a8c72ad-eb6a-4614-a54b-7fe5d3239811

	measure 'Ecom P Price Custom' = AVERAGE ( 'Ecom Data'[SellingPriceperKgL] )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: 866089cb-9359-436f-a028-c145c0798f79

	measure 'Ecom P Price YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Ecom Data'[SellingPriceperKgL] ),
			        FILTER (
			            ALL ( 'Ecom Data'[offerstartdate] ),
			            'Ecom Data'[offerstartdate] <= LastDataDate
			                && YEAR ( 'Ecom Data'[offerstartdate] ) = YEAR ( LastDataDate )
			        )
			    )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: 7c67dcf2-f812-4e2b-b68a-f4f693f97b30

	measure 'Ecom P Price MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Ecom Data'[SellingPriceperKgL] ),
			        KEEPFILTERS ( 'Ecom Data'[offerstartdate] > CutoffDate ),
			        KEEPFILTERS ( 'Ecom Data'[offerstartdate] <= GlobalMaxDate )
			    )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: 6ef50d60-c6c2-4293-80aa-ab4b245fd292

	measure 'Ecom P Price LY Custom' = CALCULATE ( [Ecom P Price Custom], DATEADD ( 'dates'[monthdate], -1, YEAR ) )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: 65834890-ba24-4b8b-8767-b90624c1af3a

	measure 'Ecom P Price LY YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Ecom Data'[SellingPriceperKgL] ),
			        FILTER (
			            ALL ( 'Ecom Data'[offerstartdate] ),
			            'Ecom Data'[offerstartdate] <= EDATE ( LastDataDate, -12 )
			                && YEAR ( 'Ecom Data'[offerstartdate] ) = YEAR ( LastDataDate ) - 1
			        )
			    )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: dd468d95-b587-4ca6-8bf2-64e9f88c56f2

	measure 'Ecom P Price LY MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR AnchorLY = EDATE ( GlobalMaxDate, -12 )
			VAR CutoffLY = EDATE ( AnchorLY, -12 )
			RETURN
			    CALCULATE (
			        AVERAGE ( 'Ecom Data'[SellingPriceperKgL] ),
			        KEEPFILTERS ( 'Ecom Data'[offerstartdate] > CutoffLY ),
			        KEEPFILTERS ( 'Ecom Data'[offerstartdate] <= AnchorLY )
			    )
		formatString: 0.00
		displayFolder: Ecom P Price
		lineageTag: 51b16a9f-fa95-4c77-bd25-60b086482ab7

	measure 'Ecom P Price Share Custom' = DIVIDE ( [Ecom P Price Custom], CALCULATE ( [Ecom P Price Custom], ALL ( 'Ecom Data' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecom P Price
		lineageTag: 79fa73af-d8ac-4a69-a53e-a61a77f56928

