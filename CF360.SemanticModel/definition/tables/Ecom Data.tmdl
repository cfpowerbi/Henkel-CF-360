	partition 'Ecom Data' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database(){[Name="henkel-clicflyer"]}[Data], "SELECT DISTINCT#(lf)    a.year as Year,#(lf)    a.Id as Offerid,#(lf)    cast(a.Data_ExtractionDate as date) as offerstartdate,#(lf)    cast(a.Data_ExtractionDate as date) as offerenddate,#(lf)   promoprice_calculated as promoprice,#(lf)    a.Ecom_RegularPrice as regularprice,#(lf)    a.PromoQuantity as promoquantity,#(lf)    a.offerpriceperpacksize as Offerpriceperpacksize,#(lf)   case when a.Ecom_Source='Tawneel' then 'Tawseel_E' else concat(a.Ecom_Source,'_E') end as `customer group`,#(lf)    a.type as  `promo type`,#(lf)    a.BrandId as brandid,#(lf)    a.BrandName as BRAND,#(lf)    a.ProductId as productid,#(lf)    a.ProductName as productname,#(lf)    a.PackSizeId as packsizeid,#(lf)  Unified_PackSize_Agg AS `SIZE`,#(lf)    -- a.Unitpacksizeid,#(lf)   -- a.basepacksize as Unitpacksize,#(lf)    --a.BasePackQty as qty,#(lf)   -- '' as coverage,#(lf)    a.bu,#(lf)    a.category_sbu as `SUB CATEGORY`,#(lf)    a.sub_category as `FORMAT`,#(lf)    --case when a.AddonPacksize is null then ""-"" else#(lf)    --a.AddonPacksize end as combo_packsize,#(lf)    --case when a.AddonPackQty is null or a.addonpackqty =0 then ""-"" else  #(lf)    --CAST(a.AddonPackQty AS STRING) end as combo_qty,#(lf)    0 as parent,#(lf)   discount_calculated/100  as discount,#(lf)    CAST(ROUND(discount_calculated , 2) AS FLOAT64) as Discount_percent,#(lf)    CASE#(lf)      WHEN a.CountryName = ""United Arab Emirates"" THEN ""UAE""#(lf)      ELSE a.countryname#(lf)    END AS country,#(lf)    CASE#(lf)      WHEN a.brandid IN (753,872,17843,59,20227,38277,1694,1694,753,1545,1502) THEN 'My Brand'#(lf)      ELSE 'Competitor'#(lf)    END AS Flag,#(lf)    --a.Total_Volume as final_volume,#(lf)    a.year_month as Yearmonth,#(lf)    '' as Channel,#(lf)    a.OfferPriceperKgL as Priceperkg_ltr_Calculated,#(lf)    CASE#(lf)      WHEN promoprice_calculated is not NULL and promoprice_calculated<>0 THEN promoprice_calculated#(lf)      ELSE Ecom_RegularPrice#(lf)  END AS SellingPrice,#(lf)  CASE#(lf)      WHEN promoprice_calculated is not NULL and promoprice_calculated<>0 THEN offerpriceperkgl#(lf)      ELSE RegularPriceperKgL#(lf)  END AS SellingPriceperKgL,#(lf)  RegularPriceperKgL,#(lf)case when discount_calculated=0#(lf)        THEN 0#(lf)    ELSE 1#(lf)END AS discount_flag,#(lf)'' AS `SUB-CHANNEL`,#(lf)'' AS `DISTRIBUTOR`,#(lf)'Online' AS `SALES TYPE`,#(lf)'' AS `BRAND STRATEGY`,#(lf)'' AS `PRICE BRAND`,#(lf)'' AS `PRODUCT TYPE`,#(lf)'' AS `PRICE TIER`,#(lf)  FROM `henkel-clicflyer.henkel_raw_data.EcomAnalysis_tbl_Henkel` a#(lf)  WHERE cast(a.Data_ExtractionDate as date) >= '2025-06-04'#(lf)    AND a.BrandName != 'others'#(lf)    AND a.ProductId != 1132#(lf)    AND a.CountryName IN ('Saudi Arabia', 'United Arab Emirates', 'Kuwait','Bahrain','Oman','Qatar')#(lf)    AND a.Country_Category IN (29, 210, 19, 110, 39, 310,49,410,59,510,69,610)#(lf)    AND year_month >= 202507", null, [EnableFolding=true]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"bu", "SUB CATEGORY", "FORMAT"}, #"Hierarchy Index", {"BU", "SubCategory", "Format"}, "Hierarchy Index", JoinKind.LeftOuter),
				    #"Expanded Hierarchy Index" = Table.ExpandTableColumn(#"Merged Queries", "Hierarchy Index", {"RNN", "rank"}, {"Hierarchy Index.RNN", "Hierarchy Index.rank"})
				in
				    #"Expanded Hierarchy Index"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

