table 'Monthly evolution Parameter'
	lineageTag: da9fe3ba-ccda-4ab1-a11a-914dc24d47a8

	/// Returns the monthly YoY growth measure matching the Value5 (EPOS/Nielsen) and Value4 (Val/Vol) slicer selections. Points at the *Growth Monthly* measures so it plots correctly across a MonthYear axis.
	measure 'Monthly evolution Parameter Growth' =
			VAR SelValue5 = SELECTEDVALUE ( 'Monthly evolution Parameter'[Value5] )
			VAR SelValue4 = SELECTEDVALUE ( 'Monthly evolution Parameter'[Value4] )
			RETURN
			    SWITCH (
			        TRUE(),
			        SelValue5 = "EPOS"    && SelValue4 = "Val", [EPOS P Value Growth Monthly],
			        SelValue5 = "EPOS"    && SelValue4 = "Vol", [EPOS P Volume Growth Monthly],
			        SelValue5 = "Nielsen" && SelValue4 = "Val", [Nielsen P Value Growth Monthly],
			        SelValue5 = "Nielsen" && SelValue4 = "Vol", [Nielsen P Volume Growth Monthly]
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e31b364f-a448-4a17-9e2f-744d73f03910

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly evolution Parameter SHARE' =
			VAR SelValue5 = SELECTEDVALUE ( 'Monthly evolution Parameter'[Value5] )
			VAR SelValue4 = SELECTEDVALUE ( 'Monthly evolution Parameter'[Value4] )
			RETURN
			    SWITCH (
			        TRUE(),
			        SelValue5 = "EPOS"    && SelValue4 = "Val", [EPOS P Value Share Dynamic],
			        SelValue5 = "EPOS"    && SelValue4 = "Vol", [EPOS P Volume Share Dynamic],
			        SelValue5 = "Nielsen" && SelValue4 = "Val", [Nielsen P Value Share Dynamic],
			        SelValue5 = "Nielsen" && SelValue4 = "Vol", [Nielsen P Volume Share Dynamic]
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a32d78b8-f4e3-4aa1-bded-88dfd3038046

	measure 'Monthly evolution Parameter Price' =
			VAR SelValue5 = SELECTEDVALUE ( 'Monthly evolution Parameter'[Value5] )
			
			RETURN
			    SWITCH (
			        TRUE(),
			        SelValue5 = "EPOS"    ,[EPOS P Price Dynamic],
			        SelValue5 = "Nielsen" , [Nielsen P Price Dynamic]
			    )
		lineageTag: d5aa3521-7b52-4aa8-9352-ff95caf86dd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

