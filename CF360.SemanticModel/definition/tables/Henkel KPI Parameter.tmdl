	measure 'Henkel KPI Growth Dynamic' =
			VAR SelectedKPI = SELECTEDVALUE ( 'Henkel KPI Parameter'[Henkel KPI Parameter Order] )
			RETURN
			    SWITCH (
			        SelectedKPI,
			        1, [Gross IMS P Growth Dynamic],
			        2, [Investment P Growth Dynamic],
			        3, [Net IMS P Growth Dynamic],
			        4, [GP1 P Growth Dynamic],
			        5, [ROI P Growth Dynamic],
			        6, [EPOS P Henkel Value Growth Dynamic],
			        7, [EPOS P Henkel Price Growth Dynamic],
			        8, [EPOS P Henkel Volume Growth Dynamic],
			        9, [L6 Elasticity P Growth Dynamic],
			        12, [Nielsen P Henkel Value Growth Dynamic],
			        13, [Nielsen P Henkel Price Growth Dynamic],
			        14, [Nielsen P Henkel Volume Growth Dynamic]
			    )
		formatString: 0.0%;-0.0%;0.0%
