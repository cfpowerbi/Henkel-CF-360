table 'Donut Parameter (Nielsen)'
	lineageTag: b9628c47-f792-45af-a440-6b2b2777dcf4

	measure 'Heading Share' =
			
			VAR SelCount =
			    COUNTROWS (
			        SUMMARIZE (
			            'Main Parameter',
			            'Main Parameter'[Parameter],
			            'Main Parameter'[Parameter Fields]
			        )
			    )
			VAR SelName =
			    IF (
			        SelCount = 1,
			        MAX ( 'Main Parameter'[Parameter] )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        SelName = "Category",
			            "Market Share by " & SelName,
			        SelName = "Sub Category",
			            SelName & " Share",
			        SelName IN { "Manufacturer", "Brand", "Country", "Price Tier","Customer Group"},
			            "All BUs · " & SelName,
			        "Market Share by " & SelName
			    )
		lineageTag: a8a2d742-0edd-43af-8ded-0397a166958c

	measure 'Heading Share 3' =
			
			SELECTEDVALUE('Donut Parameter (Nielsen)'[Value4])
		lineageTag: 7d5ae072-5bc7-40da-bbdb-30a2487a6b1a

	/// Section heading for the Online / Offline split pages. Follows the
	/// Manufacturer / Brand View By toggle.
	measure 'Online Offline Analysis Heading' =
			
			VAR _view =
			    SWITCH (
			        SELECTEDVALUE ( 'Donut Parameter (Nielsen)'[Value4], "Manufacturer" ),
			        "Manufacturer", "Manufacturer",
			        "Brand", "Brand",
			        "Manufacturer"
			    )
			RETURN
			    "Online vs Offline "
			        & UNICHAR ( 183 )
			        & " "
			        & _view
			        & " Analysis"
		lineageTag: 3f8b21a6-47c0-4d19-9b5e-6a10c7d48803

	/// GCC vs Country page: left-panel heading, e.g. "GCC Total · Manufacturer".
	measure 'GCC View Heading' =
			"GCC Total " & UNICHAR ( 183 ) & " "
			    & SELECTEDVALUE ( 'Donut Parameter (Nielsen)'[Value4], "Manufacturer" )
		lineageTag: 3f8b21a6-47c0-4d19-9b5e-6a10c7d48804

	/// GCC vs Country page: right-panel heading, e.g. "KSA · Manufacturer".
	measure 'Country View Heading' =
			[Selected Country Heading] & " " & UNICHAR ( 183 ) & " "
			    & SELECTEDVALUE ( 'Donut Parameter (Nielsen)'[Value4], "Manufacturer" )
		lineageTag: 3f8b21a6-47c0-4d19-9b5e-6a10c7d48805

	column Parameter
		lineageTag: 056a3b06-0676-47c1-b119-41d4bfa7c31d
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Parameter Order'

		relatedColumnDetails
			groupByColumn: 'Parameter Fields'

