	column 'Parameter Fields'
		isHidden
		lineageTag: be31e477-b62e-48e8-9ebc-7a5b874678fc
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Parameter Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

		annotation SummarizationSetBy = Automatic

	column 'Parameter Order'
		isHidden
		formatString: 0
		lineageTag: 412b993b-8b18-44e8-895a-f94003365663
		summarizeBy: sum
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	column Value4
		isHidden
		lineageTag: 5e7df94d-5afd-498d-bf54-81be36704b96
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value4]

		annotation SummarizationSetBy = Automatic

	partition 'Donut Parameter (Nielsen)' = calculated
		mode: import
		source =
				{
				    ("Manufacturer", NAMEOF('Nielsen Processed'[manufacturer]), 0,"Manufacturer"),
				    ("Brand", NAMEOF('Nielsen Processed'[Brand]), 1,"Brand")
				}

	annotation PBI_Id = c45aa64375904b69a9a702c3b5550d66

