	column Key
		dataType: string
		lineageTag: 6f183636-3f9c-460c-be8b-1e8d8247aabc
		summarizeBy: none
		sourceColumn: Key

		annotation SummarizationSetBy = Automatic

	partition 'All channel' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database(){[Name="henkel-clicflyer"]}[Data], "SELECT DISTINCT #(lf)  Country,Channel,Concat(Country,Channel) as Key#(lf)#(lf)FROM `henkel-clicflyer.AnalyticsSolution.epos_processed_data_henkel`#(lf)WHERE BU IS NOT NULL AND SubCategory IS NOT NULL#(lf)#(lf)UNION DISTINCT#(lf)#(lf)SELECT DISTINCT #(lf) Country,Channel,Concat(Country,Channel) as Key#(lf)#(lf)FROM `henkel-clicflyer.AnalyticsSolution.ims_processed_data_henkel`#(lf)WHERE BU IS NOT NULL AND SubCategory IS NOT NULL#(lf)#(lf)UNION DISTINCT#(lf)#(lf)SELECT DISTINCT #(lf) Country,Channel,Concat(Country,Channel) as Key#(lf)#(lf)FROM `henkel-clicflyer.AnalyticsSolution.nielsen_processed_data_henkel`#(lf)WHERE BU IS NOT NULL AND SubCategory IS NOT NULL", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

