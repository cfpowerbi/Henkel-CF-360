table 'All channel'
	lineageTag: 08fe77bc-16ce-442b-959b-3dd8500dbfb3

	measure 'Selected Country Heading' =
			
			VAR CountryPart =
			    IF(
			        HASONEVALUE('All channel'[Country]),
			        SELECTEDVALUE('All channel'[Country]),
			        "GCC Total"
			    )
			VAR FormatPart =
			    SELECTEDVALUE('Main Parameter'[Value4], "Format")
			RETURN
			    CountryPart & UNICHAR(10) & FormatPart
		lineageTag: 3b9bd25c-5f1c-4a71-9639-353ce87b5fca

	measure 'Selected HEADING MULTI COUNTRY' =
			
			IF(
			    HASONEVALUE('All channel'[Country]),
			    SELECTEDVALUE('All channel'[Country]),
			    "GCC Total"
			) & " . " & SELECTEDVALUE('Nielsen Processed'[Sales_Type]) & " . Format"
		lineageTag: 602a763a-0b92-4ac7-ad0f-6cc26b85bbaf

	measure 'Selected HEADING MULTI format' =
			
			IF(
			    HASONEVALUE('All channel'[Country]),
			    SELECTEDVALUE('All channel'[Country]),
			    "GCC Total"
			) & " . " & SELECTEDVALUE('Nielsen Processed'[Sales_Type]) & " . Manufacturer"
		lineageTag: c743f722-174e-470b-8cab-8aa6217f84b9

	/// Row-1 heading for the Online / Offline split pages. Reads "GCC Total" when
	/// every country is in scope, otherwise the selected country name(s).
	measure 'Selected Country Online Heading' =
			VAR _sel = VALUES ( 'All channel'[Country] )
			VAR _n = COUNTROWS ( _sel )
			VAR _tot = COUNTROWS ( ALL ( 'All channel'[Country] ) )
			RETURN
			    IF (
			        _n = _tot,
			        "GCC Total",
			        CONCATENATEX ( _sel, 'All channel'[Country], ", " )
			    ) & " · Online"
		lineageTag: 3f8b21a6-47c0-4d19-9b5e-6a10c7d48801

	/// Row-1 heading for the Online / Offline split pages. Reads "GCC Total" when
	/// every country is in scope, otherwise the selected country name(s).
	measure 'Selected Country Offline Heading' =
			VAR _sel = VALUES ( 'All channel'[Country] )
			VAR _n = COUNTROWS ( _sel )
			VAR _tot = COUNTROWS ( ALL ( 'All channel'[Country] ) )
			RETURN
			    IF (
			        _n = _tot,
			        "GCC Total",
			        CONCATENATEX ( _sel, 'All channel'[Country], ", " )
			    ) & " · Offline"
		lineageTag: 3f8b21a6-47c0-4d19-9b5e-6a10c7d48802

	column Channel
		dataType: string
		lineageTag: f79b7aca-51e9-49e4-b67a-b3cca3332965
