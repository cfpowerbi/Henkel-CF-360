table 'CPM Group By'
	lineageTag: 7c41d0b8-52a9-4e6d-9f31-8b02c5a17000

	/// Group-By field parameter for the Country Performance Matrix page. Every level
	/// resolves to a column on 'IMS Processed' itself, so the matrix never has to join
	/// two dimension tables and cannot raise "Can't determine relationships".
