	measure 'EPOS P Volume Dynamic' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			RETURN
			    SWITCH (
			        SelectedMode,
			        "YTD", [EPOS P Volume YTD],
			        "MAT", [EPOS P Volume MAT],
			        [EPOS P Volume Custom]
			    )
		formatString: 0
		displayFolder: EPOS P volume share
		lineageTag: 24a28909-3769-4af1-926a-36d08afbd3e1

	measure 'EPOS P Volume MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'EPOS Processed data'[volume_sales] ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] > CutoffDate ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] <= GlobalMaxDate )
			    )
		formatString: 0
		displayFolder: EPOS P volume share
		lineageTag: 17c5b7f7-ea11-4ece-8b78-feec48a6399c

	measure 'EPOS P Volume LY MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR AnchorLY = EDATE ( GlobalMaxDate, -12 )
			VAR CutoffLY = EDATE ( AnchorLY, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'EPOS Processed data'[volume_sales] ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] > CutoffLY ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] <= AnchorLY )
			    )
