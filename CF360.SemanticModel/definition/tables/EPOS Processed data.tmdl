	measure 'EPOS P Qty YTD LY' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        SUM ( 'EPOS Processed data'[volume_sales] ),
			        FILTER (
			            ALL ( 'EPOS Processed data'[monthdate] ),
			            'EPOS Processed data'[monthdate] <= EDATE ( LastDataDate, -12 )
			                && YEAR ( 'EPOS Processed data'[monthdate] ) = YEAR ( LastDataDate ) - 1
			        )
			    )
		formatString: 0
		displayFolder: EPOS P qty share
		lineageTag: 80687f18-2aea-4e1c-8b09-7c4bc434e5a5

