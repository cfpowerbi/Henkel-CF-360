	measure 'EPOS P Henkel Volume Label1' =
			VAR _value = [EPOS P Henkel Volume Dynamic]
			VAR _formattedValue =
			    IF(
			        ABS(_value) >= 1000000,
			        FORMAT(DIVIDE(_value, 1000000), "#,##0.0") & "M",
			        IF(
			            ABS(_value) >= 1000,
			            FORMAT(DIVIDE(_value, 1000), "#,##0.0") & "K",
			            FORMAT(_value, "#,##0.0")
			        )
			    )
			RETURN
			    _formattedValue
			    & UNICHAR(10) & " | "
			    & FORMAT(ABS([EPOS P Henkel Volume Share Dynamic]), "0.0%")
