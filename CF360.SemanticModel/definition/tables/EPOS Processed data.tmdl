	measure 'EPOS P Value share change' = [EPOS P Value Share Dynamic] - [EPOS P Value Share LY Dynamic]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: EPOS P value share
		lineageTag: 817b3546-6704-491f-a164-e3b2d7e0121c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EPOS P Value Label1' =
			FORMAT([EPOS P Value Dynamic] / 1000000, "#,##0.0M")
			& UNICHAR(10) & " | "
			& IF(
			    [EPOS P Value share change] >= 0,
			    FORMAT(ABS([EPOS P Value share change]), "0.0%"),
			    FORMAT(ABS([EPOS P Value share change]), "0.0%")
			)
		displayFolder: EPOS P value share
		lineageTag: 7b2c4220-c342-498c-8ef3-58f0225bd55e

	measure 'EPOS P Value Label2' =
			FORMAT([EPOS P Value Growth Dynamic], "0.0%")
			& UNICHAR(10) & " | "
			& IF(
			    [EPOS P Value Change dynamic] >= 0,
			    FORMAT(ABS([EPOS P Value Change dynamic]), "0.0%"),
			    FORMAT(ABS([EPOS P Value Change dynamic]), "0.0%")
			)
		displayFolder: EPOS P value share
		lineageTag: 2148899e-cb20-413a-bd3c-b138e8c7f20a

	measure 'EPOS P Henkel Value Label1' = ```
			
			VAR _value = [EPOS P Henkel Value Dynamic]
			VAR _formattedValue = 
			    IF(
			        ABS(_value) >= 1000000,
			        FORMAT(DIVIDE(_value, 1000000), "#,##0.0") & "M",
			        IF(
			            ABS(_value) >= 1000,
			            FORMAT(DIVIDE(_value, 1000), "#,##0.0") & "K",
			            FORMAT(_value, "#,##0.0")
			        )
			    )
			RETURN
			    _formattedValue
			    & UNICHAR(10) & " | "
			    & FORMAT(ABS([EPOS P Henkel Value Share Dynamic]), "0.0%")
			```
		displayFolder: EPOS P value Henkel share
		lineageTag: 51d36c1d-f4ca-4107-9650-79a22302df94

	measure 'EPOS P Henkel Value Label2' =
			FORMAT([EPOS P Henkel Value Growth Dynamic], "0.0%")
			& UNICHAR(10) & " | "
			& FORMAT(ABS([EPOS P Henkel Value Change Dynamic]), "0.0%")
		displayFolder: EPOS P value Henkel share
		lineageTag: f5907a54-80cd-48b9-a15d-607b9b16588b

	measure 'EPOS P Value Custom' = SUM ( 'EPOS Processed data'[sales_val] )
		formatString: 0.00
		displayFolder: EPOS P value share
		lineageTag: cd46f8a0-ebe6-403b-98d2-98b1adaac663

	measure 'EPOS P Value YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        SUM ( 'EPOS Processed data'[sales_val] ),
			        FILTER (
			            ALL ( 'EPOS Processed data'[monthdate] ),
			            'EPOS Processed data'[monthdate] <= LastDataDate
			                && YEAR ( 'EPOS Processed data'[monthdate] ) = YEAR ( LastDataDate )
			        )
			    )
		formatString: 0.00
		displayFolder: EPOS P value share
		lineageTag: 97ce60e9-b10c-4967-af7d-41ff95ff419e

	measure 'EPOS P Value Share Custom' = DIVIDE ( [EPOS P Value Custom], CALCULATE ( [EPOS P Value Custom], ALL ( 'EPOS Processed data' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: EPOS P value share
		lineageTag: a4f074ed-f4bc-41b2-bcb7-4ca41cafa356

	measure 'EPOS P Value Share YTD' = DIVIDE ( [EPOS P Value YTD], CALCULATE ( [EPOS P Value YTD], ALL ( 'EPOS Processed data' ) ) )
