		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EPOS P Value MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'EPOS Processed data'[sales_val] ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] > CutoffDate ),
			        KEEPFILTERS ( 'EPOS Processed data'[monthdate] <= GlobalMaxDate )
			    )
		formatString: 0.00
		displayFolder: EPOS P value share
		lineageTag: 2fb0a537-5103-49a6-b86b-7c37c20abd8e

