	measure 'Nielsen P Volume Dynamic' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			RETURN
			    SWITCH (
			        SelectedMode,
			        "YTD", [Nielsen P Volume YTD],
			        "MAT", [Nielsen P Volume MAT],
