	measure 'Value Explanation' = "ℹ️"
		lineageTag: e0375d33-d597-45b5-8162-829c0a8a041e

	measure 'Nielsen P Volume Custom' = SUM ( 'Nielsen Processed'[sales_volume_000] )
		formatString: 0
		displayFolder: Nielsen P volume share
		lineageTag: ef9655b0-9de0-465f-ac77-87922a5b7998

	measure 'Nielsen P Volume YTD' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_volume_000] ),
			        FILTER (
			            ALL ( 'Nielsen Processed'[monthdate] ),
			            'Nielsen Processed'[monthdate] <= LastDataDate
			                && YEAR ( 'Nielsen Processed'[monthdate] ) = YEAR ( LastDataDate )
			        )
			    )
		formatString: 0
		displayFolder: Nielsen P volume share
		lineageTag: d4d22e5b-8fd8-4b57-8f89-b3814c3f68fa

	measure 'Nielsen P Value Custom' = SUM ( 'Nielsen Processed'[sales_value_000] )
		formatString: 0.00
