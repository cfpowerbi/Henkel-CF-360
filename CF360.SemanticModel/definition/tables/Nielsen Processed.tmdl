		lineageTag: 5d9ed644-1a64-401c-880f-16e7a14cd7ce

	measure 'Nielsen P Volume YTD LY' =
			VAR LastDataDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_volume_000] ),
			        FILTER (
			            ALL ( 'Nielsen Processed'[monthdate] ),
			            'Nielsen Processed'[monthdate] <= EDATE ( LastDataDate, -12 )
			                && YEAR ( 'Nielsen Processed'[monthdate] ) = YEAR ( LastDataDate ) - 1
			        )
			    )
		formatString: 0
		displayFolder: Nielsen P volume share
		lineageTag: 408f8213-d05e-40e7-9b7d-276c13e35fe5

