	measure 'Nielsen P Value Dynamic' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			RETURN
			    SWITCH (
			        SelectedMode,
			        "YTD", [Nielsen P Value YTD],
			        "MAT", [Nielsen P Value MAT],
			        [Nielsen P Value Custom]
			    )
		formatString: 0.00
		displayFolder: Nielsen P value share
		lineageTag: 036cb3f6-b119-45f7-9679-653bd4a2c218

	measure 'Nielsen P Price Dynamic' =
			VAR SelectedMode = SELECTEDVALUE ( 'PeriodMode'[Mode], "YTD" )
			RETURN
			    SWITCH (
			        SelectedMode,
			        "YTD", [Nielsen P Price YTD],
