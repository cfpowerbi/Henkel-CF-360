		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910024

	/// Centre-of-donut card labels for the GCC row -- same magnitude switch as the
	/// country-level *Card measures. Text, display only.
	measure 'Nielsen P Value Online GCC Card' =
			VAR v = [Nielsen P Value Online GCC]
			RETURN
			    IF (
			        ISBLANK ( v ),
			        BLANK (),
			        "SAR "
			            & IF (
			            ABS ( v ) >= 1000,
			            FORMAT ( DIVIDE ( v, 1000 ), "#,0.0" ) & "M",
			            FORMAT ( v, "#,0.0" ) & "K"
			        )
			    )
		displayFolder: Nielsen P Online Offline Split
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910031

	measure 'Nielsen P Value Offline GCC Card' =
