			        [Nielsen P Price Custom]
			    )
		formatString: 0.00
		displayFolder: Nielsen P Price
		lineageTag: 8c4e5e1c-11a1-4295-a187-cfa262d15ec9

	measure 'Nielsen P Value MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_value_000] ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] > CutoffDate ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] <= GlobalMaxDate )
			    )
		formatString: 0.00
		displayFolder: Nielsen P value share
		lineageTag: ad5f69fa-2722-47fb-9424-d3594c4665e1

	measure 'Nielsen P Value LY MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR AnchorLY = EDATE ( GlobalMaxDate, -12 )
			VAR CutoffLY = EDATE ( AnchorLY, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_value_000] ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] > CutoffLY ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] <= AnchorLY )
			    )
		formatString: 0.00
		displayFolder: Nielsen P value share
		lineageTag: be59ea6c-1508-4c3e-b804-660be0aa56d8

