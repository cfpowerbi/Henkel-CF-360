	/// Row-2 label for the Format Level Analysis page, scoped to Nielsen's own
	/// Format values. Mirrors [Selected Nielsen Country].
	measure 'Selected Nielsen Format' =
			IF (
			    HASONEVALUE ( 'Hierarchy Index'[Format] ),
			    SELECTEDVALUE ( 'Hierarchy Index'[Format] ),
			    "All Formats"
			)
		displayFolder: Nielsen P Online Offline Split
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910061

	/// Panel header for the "Selected Format" row - mirrors the HTML
	/// "<Shampoo> · Online" title.
	measure 'Selected Nielsen Format Online Heading' = [Selected Nielsen Format] & " · Online"
		displayFolder: Nielsen P Online Offline Split
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910062

	/// Panel header for the "Selected Format" row - mirrors the HTML
	/// "<Shampoo> · Offline" title.
	measure 'Selected Nielsen Format Offline Heading' = [Selected Nielsen Format] & " · Offline"
		displayFolder: Nielsen P Online Offline Split
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910063

	/// GCC Total - All Formats. Strips Format and Country so row 1 always shows the
	/// whole market, matching the pbc8 note "Global Format filter will not effect
	/// the view". Wraps the existing Online/Offline split measures unchanged.
	measure 'Nielsen P Value Online AllFmt' =
			CALCULATE (
			    [Nielsen P Value Online Dynamic],
			    REMOVEFILTERS ( 'Hierarchy Index'[Format] ),
			    REMOVEFILTERS ( 'Nielsen Processed'[Format] ),
			    REMOVEFILTERS ( 'All channel'[Country] ),
			    REMOVEFILTERS ( 'Nielsen Processed'[Country] )
			)
		formatString: 0.00
		displayFolder: Nielsen P Online Offline Split
		lineageTag: 9a2c4f10-6d71-4e83-b5a2-2c7e4b910041

	measure 'Nielsen P Value Offline AllFmt' =
			CALCULATE (
			    [Nielsen P Value Offline Dynamic],
			    REMOVEFILTERS ( 'Hierarchy Index'[Format] ),
			    REMOVEFILTERS ( 'Nielsen Processed'[Format] ),
			    REMOVEFILTERS ( 'All channel'[Country] ),
