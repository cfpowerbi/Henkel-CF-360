		lineageTag: f885a524-3f61-4eb8-90ba-29d35df59425

	measure 'Nielsen P Volume MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR CutoffDate = EDATE ( GlobalMaxDate, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_volume_000] ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] > CutoffDate ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] <= GlobalMaxDate )
			    )
		formatString: 0
		displayFolder: Nielsen P volume share
		lineageTag: 25769371-da9e-433a-8049-2ee070023b70

	measure 'Nielsen P Volume LY MAT' =
			VAR GlobalMaxDate = CALCULATE ( MAX ( 'dates'[monthdate] ), ALL ( 'dates' ) )
			VAR AnchorLY = EDATE ( GlobalMaxDate, -12 )
			VAR CutoffLY = EDATE ( AnchorLY, -12 )
			RETURN
			    CALCULATE (
			        SUM ( 'Nielsen Processed'[sales_volume_000] ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] > CutoffLY ),
			        KEEPFILTERS ( 'Nielsen Processed'[monthdate] <= AnchorLY )
			    )
		formatString: 0
		displayFolder: Nielsen P volume share
		lineageTag: c2f508b4-de77-4c29-b4e4-b2850d6742f3

	measure 'Nielsen P Henkel Volume MAT' = CALCULATE ( [Nielsen P Volume MAT], 'Nielsen Processed'[manufacturer] = "HENKEL" )
