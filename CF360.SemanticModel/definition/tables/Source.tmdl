	measure 'Selected value Label 1' =
			
			VAR SelectedSource = SELECTEDVALUE('Source'[Source])
			RETURN
			SWITCH(
			    SelectedSource,
			    "IMS",     [Gross IMS P Henkel Label1],
			    "EPOS",    [EPOS P Henkel Value Label1],
			    "NIELSEN", [Nielsen P Henkel Value Label1],
